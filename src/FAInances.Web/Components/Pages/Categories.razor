@page "/categories"
@attribute [Authorize]
@rendermode InteractiveServer
@inject ICategoryService categoryService

<PageTitle>Categories · fAInances</PageTitle>

<div class="page-header">
    <h1>Categories</h1>
</div>

<section class="card form-card">
    <h2>New category</h2>
    <div class="form-grid">
        <label class="field">
            <span class="field-label">Name</span>
            <input maxlength="@CategoryService.MaxNameLength" placeholder="e.g. Groceries" @bind="newName" @bind:event="oninput" @onkeyup="OnNewKeyUpAsync" />
        </label>
        <label class="field">
            <span class="field-label">Description <span class="muted">(optional)</span></span>
            <input maxlength="@CategoryService.MaxDescriptionLength" placeholder="What goes in here?" @bind="newDescription" @bind:event="oninput" @onkeyup="OnNewKeyUpAsync" />
        </label>
    </div>
    @if (createError is not null)
    {
        <div class="alert error">@createError</div>
    }
    <div class="form-actions">
        <button type="button" class="btn primary" @onclick="CreateAsync">Add category</button>
    </div>
</section>

@if (error is not null)
{
    <div class="alert error">@error</div>
}

<section class="card list-card">
    @if (categories is null)
    {
        <p class="muted">Loading…</p>
    }
    else if (categories.Count == 0)
    {
        <div class="empty"><p>No categories yet. Add one above, or create one while adding a transaction.</p></div>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th class="actions-col"><span class="sr-only">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in categories)
                {
                    <tr @key="category.Id">
                        @if (editingId == category.Id)
                        {
                            <td><input maxlength="@CategoryService.MaxNameLength" aria-label="Name" @bind="editName" /></td>
                            <td><input maxlength="@CategoryService.MaxDescriptionLength" aria-label="Description" @bind="editDescription" /></td>
                            <td class="actions-col">
                                <button type="button" class="btn small primary" @onclick="SaveEditAsync">Save</button>
                                <button type="button" class="btn small" @onclick="CancelEdit">Cancel</button>
                            </td>
                        }
                        else
                        {
                            <td><span class="chip">@category.Name</span></td>
                            <td class="muted">@category.Description</td>
                            <td class="actions-col">
                                @if (pendingDeleteId == category.Id)
                                {
                                    <button type="button" class="btn small danger" @onclick="() => DeleteAsync(category.Id)">Delete</button>
                                    <button type="button" class="btn small" @onclick="() => pendingDeleteId = null">Keep</button>
                                }
                                else
                                {
                                    <button type="button" class="btn small" @onclick="() => StartEdit(category)">Edit</button>
                                    <button type="button" class="btn small" @onclick="() => pendingDeleteId = category.Id">Delete</button>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private string userId = string.Empty;
    private IReadOnlyList<Category>? categories;
    private string newName = string.Empty;
    private string newDescription = string.Empty;
    private string? createError;
    private string? editingId;
    private string editName = string.Empty;
    private string? editDescription;
    private string? pendingDeleteId;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        userId = (await AuthState).User.GetUserId();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        categories = await categoryService.GetAllAsync(userId);
    }

    private async Task OnNewKeyUpAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await CreateAsync();
    }

    private async Task CreateAsync()
    {
        createError = null;
        try
        {
            await categoryService.CreateAsync(userId, new CategoryInput(newName, newDescription));
            newName = newDescription = string.Empty;
            await LoadAsync();
        }
        catch (BusinessRuleException ex)
        {
            createError = ex.Message;
        }
    }

    private void StartEdit(Category category)
    {
        error = null;
        pendingDeleteId = null;
        editingId = category.Id;
        editName = category.Name;
        editDescription = category.Description;
    }

    private void CancelEdit() => editingId = null;

    private async Task SaveEditAsync()
    {
        error = null;
        try
        {
            await categoryService.UpdateAsync(userId, editingId!, new CategoryInput(editName, editDescription));
            editingId = null;
            await LoadAsync();
        }
        catch (Exception ex) when (ex is BusinessRuleException or NotFoundException)
        {
            error = ex.Message;
        }
    }

    private async Task DeleteAsync(string id)
    {
        error = null;
        pendingDeleteId = null;
        try
        {
            await categoryService.DeleteAsync(userId, id);
            await LoadAsync();
        }
        catch (Exception ex) when (ex is BusinessRuleException or NotFoundException)
        {
            error = ex.Message;
        }
    }
}
